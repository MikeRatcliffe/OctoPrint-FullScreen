<form class="form-horizontal">
    <h3>Appearance</h3>

    <h4>Tweaks</h4>

    <div class="control-group">
        <label class="control-label">Widecreen Mode</label>
        <div class="controls">
            <input type="checkbox" id="octoprint_fullscreen_widecreen_mode" data-bind="checked: settings.plugins.fullscreen.widecreen_mode">
        </div>
    </div>

    <h4>Overlay</h4>

    <p class="alert alert-block alert-info"><strong>Note:</strong> the overlay can be moved by dragging it into position when in either the <strong>maximised</strong> or <strong>fullscreen</strong> modes. The position of the overlay is saved individually for each of these views.</p>

    <div class="control-group">
        <label class="control-label">Foreground Color</label>
        <div class="controls">
            <div id="octoprint_fullscreen_picker_fg"></div>
            <input type="hidden" id="octoprint_fullscreen_color_picker_fg" data-bind="value: settings.plugins.fullscreen.foreground_color">
            <button type="button" class="ofs-reset-button" data-setting="foreground_color" data-default="rgba(255, 255, 255, 1)">Reset</button>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">Background Color</label>
        <div class="controls">
            <div id="octoprint_fullscreen_picker_bg"></div>
            <input type="hidden" id="octoprint_fullscreen_color_picker_bg" data-bind="value: settings.plugins.fullscreen.background_color">
            <button type="button" class="ofs-reset-button" data-setting="background_color" data-default="rgba(0, 0, 0, 0.25)">Reset</button>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">Font Size (px)</label>
        <div class="controls">
            <input type="number" class="input-mini"
                   data-bind="value: settings.plugins.fullscreen.font_size" min="1">
            <button type="button" class="ofs-reset-button" data-setting="font_size" data-default="25">Reset</button>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label" for="octoprint_fullscreen-font-picker">Font</label>
        <div class="controls">
            <div class="ofs-custom-font-picker" id="octoprint_fullscreen-font-picker">
                <button class="ofs-font-picker-button" type="button">Select a font...</button>
                <div class="ofs-font-dropdown" style="display: none;">
                    <div class="ofs-font-option" data-font="Arial" style="font-family: Arial;">Arial</div>
                    <div class="ofs-font-option" data-font="Courier New" style="font-family: 'Courier New';">Courier New (Monospace)</div>
                    <div class="ofs-font-option" data-font="Georgia" style="font-family: Georgia;">Georgia (Serif)</div>
                    <div class="ofs-font-option" data-font="Impact" style="font-family: Impact;">Impact (Bold/Display)</div>
                    <div class="ofs-font-option" data-font="Times New Roman" style="font-family: 'Times New Roman';">Times New Roman</div>
                    <div class="ofs-font-option" data-font="Trebuchet MS" style="font-family: 'Trebuchet MS';">Trebuchet MS</div>
                    <div class="ofs-font-option" data-font="Verdana" style="font-family: Verdana;">Verdana</div>
                </div>
            </div>
            <button type="button" class="ofs-reset-button" data-setting="font" data-default="Arial">Reset</button>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">Preview</label>
        <div class="controls">
            <div class="ofs-fullscreen-preview" id="fullscreen-preview">
                <div class="ofs-preview-overlay">
                    <div class="ofs-preview-tool-info">
                        <p><span>Hotend: 210°C ⇗ 220°C</span></p>
                        <p><span>Bed: 60°C ⇗ 60°C</span></p>
                    </div>
                    <div class="ofs-preview-print-info">
                        <p><span>Time: 1h 23m</span></p>
                        <p><span>Left: 45m</span></p>
                        <p><span>Layer: 45/100</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h4>Progress bar</h4>

    <div class="control-group">
        <label class="control-label">Color</label>
        <div class="controls">
            <div id="octoprint_fullscreen_picker_progress"></div>
            <input type="hidden" id="octoprint_fullscreen_color_picker_progress" data-bind="value: settings.plugins.fullscreen.progress_bar_color">
            <button type="button" class="ofs-reset-button" data-setting="progress_bar_color" data-default="rgba(33, 150, 243, 1)">Reset</button>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">Preview</label>
        <div class="controls">
            <div class="ofs-preview-progress">
                <div class="ofs-preview-bar"></div>
            </div>
        </div>
    </div>

</form>
